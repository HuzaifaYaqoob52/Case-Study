# ─────────────────────────────────────────────
# Environment configuration — copy to .env and fill in values
# ─────────────────────────────────────────────

# --- Video source ---
# Path to a local video file OR an RTSP URL
# Examples:
#   VIDEO_SOURCE=data/restaurant_sample.mp4
#   VIDEO_SOURCE=rtsp://admin:password@192.168.1.100:554/stream1
VIDEO_SOURCE=data/restaurant_sample.mp4

# Frames per second to sample from the video (2–5 recommended)
SAMPLE_FPS=3

# --- Table zones ---
# Path to the table polygon config file
TABLE_CONFIG=config/tables.json

# --- Detector ---
# Model name passed to YOLO (yolov8n, yolov8s, yolov8m …)
YOLO_MODEL=yolov8n.pt

# Minimum detection confidence threshold (0.0–1.0)
DETECTION_CONFIDENCE=0.35

# --- Tracker ---
# Tracker type: bytetrack or botsort
TRACKER_TYPE=bytetrack

# --- State machine thresholds (all in seconds) ---
# How long a person must be inside a zone before table → SEATED
SEATED_DEBOUNCE_SECS=20

# How long a zone must be empty before table → NEEDS_RESET
EMPTY_HOLD_OFF_SECS=60

# Rolling window (frames) for zone-occupancy smoothing
SMOOTHING_WINDOW_FRAMES=5

# --- Alerts ---
# Minutes a table stays SEATED with no staff visit before "waiting too long" alert
WAITING_ALERT_MINUTES=5

# Grace period (minutes) after table empties before "bill still open" alert
BILL_GRACE_MINUTES=3

# Alert cooldown (minutes) — suppress duplicate alerts within this window
ALERT_COOLDOWN_MINUTES=5

# --- Backend ingest (Phase 3+) ---
BACKEND_INGEST_URL=http://localhost:8000/api/ingest

# --- Output (Phase 1 annotation) ---
# Where to write the annotated output video
ANNOTATED_OUTPUT=output/annotated.mp4
